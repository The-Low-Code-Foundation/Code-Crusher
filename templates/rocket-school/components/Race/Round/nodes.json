      "type": "/Logic/Play sounds",
      "label": "The sounds",
      "x": 350,
      "y": 1480
    },
    {
      "id": "rdNextKey",
      "type": "Expression",
      "label": "The next key to press",
      "parameters": {
        "expression": "((answer || '') + '').charAt(((typed || '') + '').length)"
      },
      "x": 350,
      "y": 1120
    },
    {
      "id": "rdExpected",
      "type": "Expression",
      "label": "The word the pad checks each key against",
      "parameters": {
        "expression": "isTyping === true ? ((answer || '') + '') : ''"
      },
      "x": 350,
      "y": 520
    },
    {
      "id": "rdShowKeys",
      "type": "Expression",
      "label": "Show the keyboard?",
      "parameters": {
        "expression": "isTyping === true && !open"
      },
      "x": 350,
      "y": 1240
    },
    {
      "id": "rdBoxOn",
      "type": "Expression",
      "label": "The box answers until the banner is up",
      "parameters": {
        "expression": "!open"
      },
      "x": 350,
      "y": 640
    },
    {
      "id": "rdCanTeach",
      "type": "Expression",
      "label": "Something to teach?",
      "parameters": {
        "expression": "correct !== true && ((teach || '') + '').length > 0"
      },
      "x": 350,
      "y": 1000
    },
    {
