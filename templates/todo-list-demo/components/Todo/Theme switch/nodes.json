{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "32a6a325-9b74-57f3-873c-353667740bf0",
  "version": 1,
  "nodes": [
    {
      "id": "thRoot",
      "type": "Group",
      "label": "Theme switch",
      "parameters": {
        "flexDirection": "row",
        "alignItems": "center",
        "sizeMode": "contentSize"
      },
      "children": [
        "thToDark",
        "thToLight"
      ],
      "x": 40,
      "y": 40
    },
    {
      "id": "thToDark",
      "type": "net.noodl.controls.button",
      "label": "Use dark theme",
      "parent": "thRoot",
      "parameters": {
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderStyle": "none",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "sizeMode": "contentSize",
        "label": "Use dark theme",
        "styleCss": "font-size: 0;",
        "useIcon": true,
        "iconSourceType": "icon",
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-moon",
          "codeAsClass": true
        },
        "iconSize": 16,
        "iconSpacing": 0,
        "iconColor": "var(--muted-foreground)",
        "paddingLeft": "var(--space-2)",
        "paddingRight": "var(--space-2)",
        "cssClassName": "todo-theme-to-dark"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "thToLight",
      "type": "net.noodl.controls.button",
      "label": "Use light theme",
      "parent": "thRoot",
      "parameters": {
        "backgroundColor": "transparent",
        "color": "var(--foreground)",
        "borderStyle": "none",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-2)",
        "paddingBottom": "var(--space-2)",
        "sizeMode": "contentSize",
        "label": "Use light theme",
        "styleCss": "font-size: 0;",
        "useIcon": true,
        "iconSourceType": "icon",
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-sun",
          "codeAsClass": true
        },
        "iconSize": 16,
        "iconSpacing": 0,
        "iconColor": "var(--muted-foreground)",
        "paddingLeft": "var(--space-2)",
        "paddingRight": "var(--space-2)",
        "cssClassName": "todo-theme-to-light"
      },
      "x": 100,
      "y": 280
    },
    {
      "id": "thFlip",
      "type": "JavaScriptFunction",
      "label": "Switch to the other theme",
      "parameters": {
        "functionScript": "var KEY = \"nodegx-todo-list-theme\";\nfunction systemTheme() {\n  return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';\n}\nfunction chosenTheme() {\n  var v = null;\n  try { v = window.localStorage.getItem(KEY); } catch (e) { v = window.__todoTheme || null; }\n  return v === 'dark' || v === 'light' ? v : null;\n}\nfunction remember(v) {\n  window.__todoTheme = v;\n  try { if (v) window.localStorage.setItem(KEY, v); else window.localStorage.removeItem(KEY); } catch (e) {}\n}\nfunction applyTheme(v) {\n  if (v) document.documentElement.setAttribute('data-theme', v);\n  else document.documentElement.removeAttribute('data-theme');\n}\nvar showing = chosenTheme() || systemTheme();\nvar next = showing === 'dark' ? 'light' : 'dark';\nvar keep = next === systemTheme() ? null : next;\nremember(keep);\napplyTheme(keep);"
      },
      "x": 350,
      "y": 160
    }
  ],
  "visualRoots": [
    "thRoot"
  ]
}
